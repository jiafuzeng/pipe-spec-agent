{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "释放调试端口",
      "type": "shell",
      "command": "ROOT='${workspaceFolder}'; echo '停止旧调试进程…'; pkill -f \"$ROOT/.venv/bin/python -m uvicorn main:app\" 2>/dev/null || true; pkill -f \"$ROOT/.venv/bin/python -m pipe_assessment_mcp\" 2>/dev/null || true; pkill -f \"$ROOT/.venv/bin/pipe-assessment-mcp\" 2>/dev/null || true; pkill -f \"$ROOT/frontend/node_modules/.bin/vite\" 2>/dev/null || true; pkill -f \"$ROOT/frontend/node_modules/vite/bin/vite.js\" 2>/dev/null || true; for port in 8000 8001 5173; do pids=$(lsof -nP -tiTCP:$port -sTCP:LISTEN 2>/dev/null || true); if [ -n \"$pids\" ]; then echo \"释放 $port: $pids\"; kill $pids 2>/dev/null || true; sleep 0.25; still=$(lsof -nP -tiTCP:$port -sTCP:LISTEN 2>/dev/null || true); if [ -n \"$still\" ]; then kill -9 $still 2>/dev/null || true; fi; fi; done; sleep 0.35; for port in 8000 8001 5173; do if lsof -nP -iTCP:$port -sTCP:LISTEN >/dev/null 2>&1; then echo \"$port 仍被占用\" >&2; lsof -nP -iTCP:$port -sTCP:LISTEN >&2; exit 1; fi; done; echo \"8000/8001/5173 可用\"",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "silent",
        "panel": "shared",
        "showReuseMessage": false,
        "clear": true,
        "close": true
      }
    },
    {
      "label": "MCP",
      "type": "shell",
      "command": "set -a && [ -f .env ] && . ./.env; set +a; exec .venv/bin/python -m pipe_assessment_mcp",
      "options": {
        "cwd": "${workspaceFolder}",
        "env": {
          "MCP_HOST": "127.0.0.1",
          "MCP_PORT": "8001"
        }
      },
      "isBackground": true,
      "problemMatcher": {
        "owner": "mcp",
        "pattern": { "regexp": "^.*$" },
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".",
          "endsPattern": "Uvicorn running on"
        }
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "group": "workbench"
      }
    },
    {
      "label": "API",
      "type": "shell",
      "command": "set -a && [ -f .env ] && . ./.env; set +a; exec .venv/bin/python -m uvicorn main:app --host 127.0.0.1 --port 8000 --workers 1",
      "options": {
        "cwd": "${workspaceFolder}",
        "env": {
          "MCP_URL": "http://127.0.0.1:8001/mcp"
        }
      },
      "isBackground": true,
      "problemMatcher": {
        "owner": "api",
        "pattern": { "regexp": "^.*$" },
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".",
          "endsPattern": "Uvicorn running on"
        }
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "group": "workbench"
      }
    },
    {
      "label": "前端",
      "type": "shell",
      "command": "npm run dev",
      "options": {
        "cwd": "${workspaceFolder}/frontend"
      },
      "isBackground": true,
      "problemMatcher": {
        "owner": "frontend",
        "pattern": { "regexp": "^.*$" },
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".",
          "endsPattern": "http://127\\.0\\.0\\.1:5173"
        }
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "group": "workbench"
      }
    },
    {
      "label": "工作台并行",
      "dependsOn": ["MCP", "API", "前端"],
      "dependsOrder": "parallel",
      "problemMatcher": [],
      "group": "none"
    },
    {
      "label": "启动工作台",
      "dependsOn": ["释放调试端口", "工作台并行"],
      "dependsOrder": "sequence",
      "problemMatcher": [],
      "group": {
        "kind": "build",
        "isDefault": true
      }
    }
  ]
}
